# ==============================================================================
# VYNK Deployment & Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize with your deployment secrets.
#
# QUICK START:
#   1. cp .env.example .env
#   2. Fill in DB_PASSWORD and your Resend API Key
#   3. docker compose up -d --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL)
# ------------------------------------------------------------------------------
DB_NAME=vynk_db
DB_USERNAME=root
DB_PASSWORD=replace_with_strong_password_here
DB_PORT=3306

# JDBC URL for local IDE development outside Docker (Optional):
DB_URL=jdbc:mysql://localhost:3306/vynk_db?serverTimezone=Asia/Kolkata&sslMode=DISABLED&allowPublicKeyRetrieval=true

# Database Migrations (Flyway): disabled by default in production to protect existing live schema.
# Set true for local sandbox initialization:
VYNK_FLYWAY_ENABLED=false

# ------------------------------------------------------------------------------
# 2. EMAIL NOTIFICATIONS & OTP DELIVERY (Resend HTTPS API)
# ------------------------------------------------------------------------------
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# Configured sender: onboarding@resend.dev (testing) or your verified custom domain
RESEND_FROM_EMAIL=onboarding@resend.dev

# Server-side secret pepper for HMAC-SHA256 OTP hash generation (REQUIRED IN PRODUCTION):
# Generate a high-entropy 64-character secret using: openssl rand -hex 32
VYNK_OTP_PEPPER=replace_with_secure_random_server_pepper_secret

# Optional: set true only for offline/local UI testing without contacting Resend
# VYNK_RESEND_SIMULATION_MODE=false

# ------------------------------------------------------------------------------
# 3. WEB & COOKIE SECURITY
# ------------------------------------------------------------------------------
# Set to 'true' if deployed over HTTPS (SSL). Set to 'false' if accessed over HTTP/localhost:
VYNK_SESSION_COOKIE_SECURE=false

# Base URL where the frontend is publicly accessible (used for CORS & password reset links):
VYNK_FRONTEND_BASE_URL=http://localhost

# Public port on which the Nginx frontend will be exposed on your server:
FRONTEND_PORT=80

# ------------------------------------------------------------------------------
# 4. AI SEMANTIC INFERENCE MICROSERVICE (Phase 4)
# ------------------------------------------------------------------------------
VYNK_INFERENCE_HOST=0.0.0.0
VYNK_INFERENCE_PORT=8001
