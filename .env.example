# VYNK Environment Configuration Template
# Copy this file to .env or set these environment variables in your Windows User Environment / IDE Launch Configuration.

# Database Credentials (REQUIRED)
# In local development with MySQL, set your database password:
DB_PASSWORD=your_mysql_password_here
DB_USERNAME=root
DB_URL=jdbc:mysql://localhost:3306/vynk_db?serverTimezone=Asia/Kolkata&sslMode=DISABLED&allowPublicKeyRetrieval=true

# Mail Credentials (for student email verification)
VYNK_MAIL_USERNAME=your_gmail_address@gmail.com
VYNK_MAIL_PASSWORD=your_gmail_app_password

# Cookie Security (set to true in HTTPS production, false in HTTP localhost)
VYNK_SESSION_COOKIE_SECURE=false

# Local AI Semantic Inference Microservice (Phase 4)
VYNK_INFERENCE_HOST=127.0.0.1
VYNK_INFERENCE_PORT=8001
