# ==============================================================================
# VYNK Deployment & Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize with your deployment secrets.
#
# QUICK START:
#   1. cp .env.example .env
#   2. Fill in DB_PASSWORD and your Gmail App Password
#   3. docker compose up -d --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL)
# ------------------------------------------------------------------------------
DB_NAME=vynk_db
DB_USERNAME=root
DB_PASSWORD=replace_with_strong_password_here
DB_PORT=3306

# JDBC URL for local IDE development outside Docker (Optional):
DB_URL=jdbc:mysql://localhost:3306/vynk_db?serverTimezone=Asia/Kolkata&sslMode=DISABLED&allowPublicKeyRetrieval=true

# Database Migrations (Flyway): set true to automatically apply migrations on startup
VYNK_FLYWAY_ENABLED=true

# ------------------------------------------------------------------------------
# 2. EMAIL VERIFICATION & NOTIFICATIONS (Gmail SMTP)
# ------------------------------------------------------------------------------
# Requires a Gmail address with a 16-character Google App Password (not your normal password):
# https://myaccount.google.com/apppasswords
VYNK_MAIL_USERNAME=your_email@gmail.com
VYNK_MAIL_PASSWORD=your_gmail_app_password_here

# ------------------------------------------------------------------------------
# 3. WEB & COOKIE SECURITY
# ------------------------------------------------------------------------------
# Set to 'true' if deployed over HTTPS (SSL). Set to 'false' if accessed over HTTP/localhost:
VYNK_SESSION_COOKIE_SECURE=false

# Base URL where the frontend is publicly accessible (used for CORS & password reset links):
VYNK_FRONTEND_BASE_URL=http://localhost

# Public port on which the Nginx frontend will be exposed on your server:
FRONTEND_PORT=80

# ------------------------------------------------------------------------------
# 4. AI SEMANTIC INFERENCE MICROSERVICE (Phase 4)
# ------------------------------------------------------------------------------
VYNK_INFERENCE_HOST=0.0.0.0
VYNK_INFERENCE_PORT=8001
