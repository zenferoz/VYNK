# ==============================================================================
# VYNK Backend Environment Configuration Template
# ==============================================================================

# Server Port (Railway provides PORT dynamically)
PORT=8080

# Public URL of the frontend (Vercel deployment URL)
VYNK_FRONTEND_BASE_URL=https://your-frontend-app.vercel.app

# Database Configuration (Aiven MySQL)
# Example: jdbc:mysql://mysql-xxxx.h.aivencloud.com:16515/defaultdb?sslMode=REQUIRED
DB_URL=jdbc:mysql://<AIVEN_HOST>:<AIVEN_PORT>/<DATABASE_NAME>?sslMode=REQUIRED
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password_here
# Flyway is disabled by default in production; set true only for isolated sandboxes
VYNK_FLYWAY_ENABLED=false

# Resend Email Configuration (HTTPS API)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# Configured sender: onboarding@resend.dev (testing) or your verified domain
RESEND_FROM_EMAIL=onboarding@resend.dev

# OTP Security Pepper (REQUIRED IN PRODUCTION: server-side secret key for HMAC-SHA256 OTP hashing)
# Generate a high-entropy 64-character secret using: openssl rand -hex 32
VYNK_OTP_PEPPER=your_random_secure_server_pepper_secret

# Optional: set true only for offline/local development without contacting Resend
# VYNK_RESEND_SIMULATION_MODE=false

# Session & Cookie Security
# For cross-site deployments (Vercel frontend to Railway backend):
VYNK_SESSION_COOKIE_SECURE=true
VYNK_SESSION_COOKIE_SAMESITE=none
